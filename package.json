{
  "name": "deckhand",
  "private": true,
  "version": "0.1.6",
  "description": "Visual editor for HTML presentations",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build -w @deckhand/bridge && npm run dev -w @deckhand/desktop",
    "build": "npm run build -w @deckhand/bridge && npm run build -w @deckhand/desktop",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "npm run build && playwright test",
    "dist": "npm run build && npm run dist -w @deckhand/desktop",
    "gen:decks": "node scripts/gen-test-decks.mjs",
    "gen:bench": "node scripts/gen-benchmark.mjs",
    "bench": "npm run build && playwright test e2e/benchmark.spec.ts --repeat-each=3",
    "screenshot": "electron scripts/screenshot.cjs",
    "postinstall": "node scripts/ensure-electron.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0"
}
