{
  "name": "deckhand",
  "private": true,
  "version": "0.1.0",
  "description": "Visual editor for HTML presentations",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @deckhand/desktop",
    "build": "npm run build -w @deckhand/desktop",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "dist": "npm run build && npm run dist -w @deckhand/desktop",
    "gen:decks": "node scripts/gen-test-decks.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
